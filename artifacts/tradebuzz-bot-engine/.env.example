# TradeBuzz Bot Engine — Environment Variables
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/tradebuzz

# --- Admin API Key (used to authenticate all admin endpoints) ---
ADMIN_API_KEY=change-me-to-a-secure-random-string

# --- Bot Mode ---
# PAPER = paper trading only (safe, default)
# LIVE  = live trading (requires LIVE_TRADING_ENABLED=true below)
BOT_MODE=PAPER

# --- Live Trading Safety Gate ---
# Must be explicitly set to true to allow any live order to be placed
LIVE_TRADING_ENABLED=false

# --- Bot Cycle Interval (seconds) ---
BOT_CYCLE_INTERVAL=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Telegram Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email Alerts (optional) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
